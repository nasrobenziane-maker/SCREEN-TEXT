<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ScreenText</AssemblyName>
    <RootNamespace>ScreenText</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TesseractOCR" Version="5.5.2" />
    <EmbeddedResource Include="tessdata\ara.traineddata" LogicalName="ScreenText.Ocr.ara.traineddata" />
    <EmbeddedResource Include="tessdata\eng.traineddata" LogicalName="ScreenText.Ocr.eng.traineddata" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
